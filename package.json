{
  "name": "@and-effect/ag-ui-vue",
  "version": "0.5.1",
  "description": "Vue composables for the AG-UI protocol — connect AI agents to Vue frontends",
  "type": "module",
  "license": "MIT",
  "author": "&effect data solutions GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/and-effect/ag-ui-vue.git"
  },
  "homepage": "https://github.com/and-effect/ag-ui-vue#readme",
  "bugs": {
    "url": "https://github.com/and-effect/ag-ui-vue/issues"
  },
  "keywords": [
    "vue",
    "ag-ui",
    "ai",
    "agent",
    "chatbot",
    "composable",
    "streaming",
    "pydantic-ai"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build",
    "dev:playground": "npm run dev -w examples/playground",
    "dev:backend": "make -C examples/backend dev"
  },
  "peerDependencies": {
    "@ag-ui/client": "^1.0.0",
    "@ag-ui/core": "^1.0.0",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.0",
    "@ag-ui/core": "^1.0.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "arktype": "^2.2.9",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "examples/playground"
  ]
}
